{
  "name": "lumina-code",
  "displayName": "Lumina Code",
  "description": "A minimal, eye-comfortable VS Code theme family derived from Lumina's deep-space violet, teal, indigo, and slate palette.",
  "version": "1.2.0",
  "license": "MIT",
  "publisher": "Akio333",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akio333/vscode-lumina-code-theme"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "validate": "node scripts/build.js --check && node scripts/validate.js",
    "package": "npm run validate && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.9.3"
  },
  "contributes": {
    "themes": [
      {
        "label": "Lumina Code (Standard)",
        "uiTheme": "vs-dark",
        "path": "./themes/lumina-code-color-theme.json"
      },
      {
        "label": "Lumina Code (Deep)",
        "uiTheme": "vs-dark",
        "path": "./themes/lumina-code-deep-color-theme.json"
      },
      {
        "id": "Lumina Code (Lighter)",
        "label": "Lumina Code (Dim)",
        "uiTheme": "vs-dark",
        "path": "./themes/lumina-code-lighter-color-theme.json"
      },
      {
        "label": "Lumina Code Light",
        "uiTheme": "vs",
        "path": "./themes/lumina-code-light-color-theme.json"
      }
    ]
  }
}
